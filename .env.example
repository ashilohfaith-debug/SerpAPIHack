# RELAY settings — copy this file to ".env" (same folder), paste your keys, save.
# Everything here is optional: with an empty file RELAY still works fully offline.
# Never commit .env: it holds your keys. (.gitignore already excludes it.)

# ---- Sarvam AI voice (natural Indian voice for everything RELAY says) ----
# Get a key at https://dashboard.sarvam.ai  ->  API keys
SARVAM_API_KEY=
# Voice model and speaker (leave the speaker empty for Sarvam's default voice;
# the speaker list is in Sarvam's text-to-speech docs, e.g. shubh, aditya, ritu, priya).
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=
# Accent of the voice. RELAY talks in English, so en-IN (Indian English) fits best.
SARVAM_LANGUAGE=en-IN
# Also use Sarvam for speech recognition (better with Indian accents; Hindi, Tamil ...
# are translated to English commands). Only speech addressed to RELAY is uploaded:
# the wake word is checked on this PC first. on / off
SARVAM_STT=off
# Optional: your own proxy in front of api.sarvam.ai that adds the real key, so a
# public build never contains it. Then SARVAM_API_KEY is your proxy's app token.
# SARVAM_BASE_URL=https://your-gateway.example.com/sarvam

# ---- AI assistant through FreeLLMAPI (or any OpenAI-compatible /v1 router) ----
# FreeLLMAPI on this PC: http://localhost:3001/v1 ; the key is from its dashboard.
# For other people's PCs, host the router somewhere they can reach (https://...).
RELAY_LLM_URL=
RELAY_LLM_KEY=
